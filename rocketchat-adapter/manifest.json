{
  "id": "rocketchat-adapter",
  "name": "Rocket.Chat Adapter",
  "version": "0.1.0",
  "type": "extension",
  "main": "dist/index.js",
  "description": "Development preview: relay direct WhatsApp text messages to Rocket.Chat Omnichannel and agent text replies back to WhatsApp.",
  "author": "yederlv",
  "license": "MIT",
  "homepage": "https://github.com/rmyndharis/OpenWA-plugins/tree/main/rocketchat-adapter",
  "repository": "https://github.com/rmyndharis/OpenWA-plugins",
  "keywords": [
    "rocketchat",
    "omnichannel",
    "whatsapp",
    "helpdesk"
  ],
  "status": "development",
  "minOpenWAVersion": "0.27.0",
  "testedOpenWAVersion": "0.27.1",
  "sdkVersion": "1",
  "permissions": [
    "net:fetch",
    "conversation:send",
    "webhook:ingress",
    "storage:use"
  ],
  "net": {
    "allow": [],
    "allowConfigHosts": [
      "baseUrl"
    ]
  },
  "sessionScoped": true,
  "sessions": [
    "*"
  ],
  "hooks": [
    "message:received"
  ],
  "ingress": [
    {
      "route": "omnichannel",
      "mode": "async",
      "verify": "core",
      "maxBodyBytes": 262144,
      "signature": {
        "scheme": "shared-secret",
        "header": "X-RocketChat-Livechat-Token"
      },
      "dedupOn": "body",
      "conversationId": {
        "jsonPointer": "/_id"
      },
      "response": {
        "preflight": [
          {
            "type": "session-alive"
          }
        ],
        "ack": {
          "status": 200,
          "body": "ok",
          "headers": {
            "Content-Type": "text/plain"
          }
        }
      }
    }
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "baseUrl": {
        "type": "string",
        "title": "Rocket.Chat origin",
        "required": true,
        "description": "Rocket.Chat HTTPS origin only, without paths or embedded credentials."
      },
      "sessionId": {
        "type": "string",
        "title": "WhatsApp session ID",
        "required": true,
        "description": "Exact OpenWA session UUID. Bind the ingress instance to this same session."
      },
      "department": {
        "type": "string",
        "title": "Omnichannel department",
        "description": "Optional Rocket.Chat department name or ID used when registering visitors. Changing it creates a new mapping namespace."
      },
      "deadLetterAction": {
        "type": "string",
        "title": "Dead-letter action",
        "enum": [
          "none",
          "replay",
          "clear"
        ],
        "default": "none",
        "description": "Operator maintenance: replay retained failures or clear them without deleting chat mappings. Requires a fresh action ID."
      },
      "deadLetterActionId": {
        "type": "string",
        "title": "Dead-letter action ID",
        "description": "Unique request ID (1-100 letters, digits, hyphens or underscores). Reusing an ID does not repeat the operation."
      }
    }
  },
